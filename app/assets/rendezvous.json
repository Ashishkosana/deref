  "source": "\ndef solve(nums, target):\n    L, R = 0, len(nums) - 1\n    while L < R:\n        s = nums[L] + nums[R]\n        if s == target:\n            return (L + 1, R + 1)\n        if s > target:\n            R -= 1\n        else:\n            L += 1\n    return None\n",
